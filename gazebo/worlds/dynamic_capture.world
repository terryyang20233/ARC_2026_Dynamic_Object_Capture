<?xml version="1.0" ?>
<!-- Gazebo Harmonic (gz-sim 8) capture world.
     Classic 11 plugins were removed: this workstation has Harmonic, not gazebo11.
     Camera topic: /catcher/image  (RGB, 640x480, hfov matches capture_sim.Camera fx=500)
-->
<sdf version="1.8">
  <world name="dynamic_capture">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <physics name="capture_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>0</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.7 0.8 1</ambient>
      <background>0.45 0.65 0.85 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="court">
      <static>true</static>
      <pose>0 10 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 28 0.02</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 28 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.45 0.18 1</ambient>
            <diffuse>0.2 0.55 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://tennis_ball</uri>
      <name>tennis_ball</name>
      <pose>0.4 9.5 2.4 0 0 0</pose>
    </include>
    <include>
      <uri>model://catcher_drone</uri>
      <name>catcher_drone</name>
      <pose>0 0 1.55 0 0 1.5708</pose>
    </include>
  </world>
</sdf>
