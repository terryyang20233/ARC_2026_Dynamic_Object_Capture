<?xml version="1.0"?>
<sdf version="1.8">
  <model name="catcher_drone">
    <pose>0 0 1.55 0 0 1.5708</pose>
    <link name="base_link">
      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.012</iyy>
          <izz>0.021</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.35 0.35 0.12</size></box>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0x01</collide_bitmask>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.35 0.35 0.12</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.12 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <!-- Catch net, 0.32 m forward of CoM (matches InterceptPlanner.catch_offset). -->
      <visual name="net">
        <pose>0.32 0 0.04 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.55 0.15 1</ambient>
          <diffuse>0.1 0.7 0.2 1</diffuse>
        </material>
      </visual>
      <!-- hfov = 2*atan(320/500) so pinhole fx matches capture_sim.Camera -->
      <sensor name="front_camera" type="camera">
        <pose>0.08 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>catcher/image</topic>
        <camera name="cam">
          <horizontal_fov>1.142</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.08</near>
            <far>40</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
