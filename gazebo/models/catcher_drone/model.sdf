<?xml version="1.0"?>
<sdf version="1.7">
  <model name="catcher_drone">
    <pose>0 0 1.55 0 0 1.5708</pose>
    <link name="base_link">
      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.012</iyy>
          <izz>0.021</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.35 0.35 0.12</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.35 0.35 0.12</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.12 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera name="cam">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.08</near>
            <far>40</far>
          </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/catcher</namespace>
            <remapping>image_raw:=image_raw</remapping>
            <remapping>camera_info:=camera_info</remapping>
          </ros>
          <camera_name>front</camera_name>
          <frame_name>front_camera_optical</frame_name>
          <hack_baseline>0.0</hack_baseline>
        </plugin>
      </sensor>
    </link>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/catcher</namespace>
      </ros>
      <update_rate>50</update_rate>
    </plugin>
  </model>
</sdf>
