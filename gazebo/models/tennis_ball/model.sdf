<?xml version="1.0"?>
<sdf version="1.8">
  <model name="tennis_ball">
    <!-- ITF tennis ball: ~57 g, diameter 67 mm, Cd ~0.55 -->
    <pose>0 0 0.034 0 0 0</pose>
    <link name="ball">
      <inertial>
        <mass>0.057</mass>
        <inertia>
          <ixx>2.55e-05</ixx>
          <iyy>2.55e-05</iyy>
          <izz>2.55e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere><radius>0.0335</radius></sphere>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0.75</restitution_coefficient>
            <threshold>0.05</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
          <contact>
            <collide_bitmask>0x02</collide_bitmask>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere><radius>0.0335</radius></sphere>
        </geometry>
        <material>
          <ambient>0.85 0.92 0.12 1</ambient>
          <diffuse>0.90 0.95 0.10 1</diffuse>
          <specular>0.4 0.4 0.3 1</specular>
          <emissive>0.15 0.18 0.02 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
